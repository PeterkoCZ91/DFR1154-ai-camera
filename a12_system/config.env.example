# ============================================================
# A12 System v2 — Configuration Template
# Copy to your data directory as config.env and fill in values.
# Required fields are marked with (REQUIRED).
# ============================================================

# ------------------------------------------------------------
# CAMERA (REQUIRED)
# IP address of the ESP32 camera on your LAN.
# Default ports: 80=API, 81=stream, 82=audio.
# CAMERA_ID must be unique when running multiple A12 instances.
# CAMERA_NAME/CAMERA_LABEL are shown in logs, Telegram, and Home Assistant.
# ------------------------------------------------------------
CAMERA_ID=gate
CAMERA_NAME="Gate Camera"
CAMERA_LABEL="Gate"
ESP32_IP=192.168.1.100

# ------------------------------------------------------------
# TELEGRAM (optional but recommended)
# Get token from @BotFather, chat_id from @userinfobot.
# TELEGRAM_MEDIA_MODE options:
#   preview_mp4  — short clip preview (default, recommended)
#   mp4          — full clip
#   snapshot     — single JPEG
#   text         — text only
#   none         — disable media, text only
# ------------------------------------------------------------
#TELEGRAM_ENABLED=true
#TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
#TELEGRAM_CHAT_ID=-100123456789
#TELEGRAM_MEDIA_MODE=preview_mp4
#TELEGRAM_PREVIEW_SECONDS=4
#TELEGRAM_PREVIEW_FPS=4

# ------------------------------------------------------------
# MQTT broker — Home Assistant / Mosquitto (REQUIRED for HA)
# ------------------------------------------------------------
MQTT_BROKER=192.168.1.10
MQTT_PORT=1883
# Use a unique base topic per A12 instance, for example esp32_camera_gate and esp32_camera_yard.
MQTT_BASE_TOPIC=esp32_camera_gate
# Optional HA discovery node override. Usually CAMERA_ID is enough for non-default instances.
#MQTT_DISCOVERY_NODE=esp32_camera_gate
#MQTT_USERNAME=your_username
#MQTT_PASSWORD=your_password

# PIR sensor entity in Home Assistant (binary_sensor.* or input_boolean.*)
# When triggered, A12 runs YOLO for EXTERNAL_TRIGGER_YOLO_WINDOW_SECONDS.
#HA_PIR_SENSOR=binary_sensor.venkovni_senzor
#HA_PIR_HOLD_SECONDS=30

# ------------------------------------------------------------
# HOME ASSISTANT (optional — for alarm/light control)
# ------------------------------------------------------------
#HOME_ASSISTANT_URL=http://homeassistant.local:8123
#HOME_ASSISTANT_TOKEN=your_long_lived_access_token

# ------------------------------------------------------------
# DETECTION
# YOLO_CLASSES: comma-separated COCO class names to alert on.
# Confidence 0.0–1.0. PIR-assisted detections use lower threshold.
# ------------------------------------------------------------
# Default backend is local cv2.dnn. To test a shared scorer service, set:
#YOLO_BACKEND=http
#YOLO_SCORER_URL=http://SCORER_HOST:8766/score
YOLO_WEIGHTS=yolo11n.onnx
YOLO_CONFIDENCE_THRESHOLD=0.55
YOLO_NOTIFY_CONFIDENCE_THRESHOLD=0.55
YOLO_PERSON_CONFIRMATIONS=2
YOLO_PIR_NOTIFY_CONFIDENCE_THRESHOLD=0.60
YOLO_PIR_PERSON_CONFIRMATIONS=2
YOLO_CLASSES=person,dog

# Camera-only periodic YOLO check interval (seconds). 300 = every 5 min.
PERIODIC_YOLO_INTERVAL=300

# PIR-triggered YOLO window: run YOLO every N seconds for M seconds after trigger.
EXTERNAL_TRIGGER_YOLO_WINDOW_SECONDS=25
EXTERNAL_TRIGGER_YOLO_INTERVAL_SECONDS=2

# Motion detection (0 = disabled, relies on PIR only)
MOTION_THRESHOLD=0

# Stream decode rates (fps). Active = during detection window.
STREAM_IDLE_DECODE_FPS=2
STREAM_ACTIVE_DECODE_FPS=10

# ------------------------------------------------------------
# GROQ VISION FACE RECOGNITION (optional)
#
# Why use this instead of local dlib face recognition?
#   - No local model to install or train — just drop reference photos in a folder
#   - Works from partial views, different lighting, and varying angles
#   - LLaMA 4 Scout is free at console.groq.com (1000 req/min free tier)
#
# How it works:
#   1. Place 2–3 JPEG reference photos in: <A12_DATA_DIR>/known_faces/<name>/
#      Example: known_faces/john/ref_01.jpg, known_faces/john/ref_02.jpg
#   2. When YOLO detects a person, A12 sends the live frame + references to Groq
#   3. Result:
#      - confidence >= 0.90  → known person, Telegram skipped, Nuki unlock triggered
#      - confidence 0.65–0.89 → uncertain, Telegram sent with name hint
#      - confidence < 0.65   → unknown person, full Telegram alert
#   4. API calls are rate-limited to 1 per 30 seconds to avoid 429 errors
#
# GROQ_API_KEY: get free at https://console.groq.com → API Keys
# ------------------------------------------------------------
#GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------
# NUKI SMART LOCK (optional — requires Home Assistant + Nuki integration)
#
# When Groq recognizes a known person with confidence >= 0.90, A12 calls
# the HA lock.unlock service automatically. No button press needed.
# Find your entity ID in HA: Settings → Devices → Nuki → entity_id
#
# Why is this better than a keypad?
#   - Completely hands-free — works even when your hands are full
#   - Logs every unlock with a photo in A12's event database
#   - Unknown visitors still trigger a Telegram alert
# ------------------------------------------------------------
#NUKI_LOCK_ENTITY_ID=lock.nuki_smart_lock

# Legacy dlib face recognition (disabled when GROQ_API_KEY is set)
FACE_RECOGNITION_ENABLED=false

# ------------------------------------------------------------
# MEDIA CLIPS
# Local MP4: 960x720 full quality; Telegram preview: 640x480.
# ------------------------------------------------------------
GIF_FPS=10
CLIP_PRE_SECONDS=5
CLIP_POST_SECONDS=30
CLIP_BUFFER_FPS=10
CLIP_FRAME_WIDTH=640
CLIP_FRAME_HEIGHT=480

# Event score thresholds (0–100). notify=Telegram, local_record=save MP4.
EVENT_SCORE_NOTIFY_THRESHOLD=70
EVENT_SCORE_LOCAL_RECORD_THRESHOLD=45

# Require PIR/HA sensor confirmation before saving recording
REQUIRE_SENSOR_FOR_RECORDING=true

# Extend clip while person stays in frame (up to ADAPTIVE_CLIP_MAX_POST_SECONDS)
ADAPTIVE_CLIP_ENABLED=true
ADAPTIVE_CLIP_IDLE_SECONDS=10
ADAPTIVE_CLIP_MAX_POST_SECONDS=30

# Delete media older than N days (0 = keep forever)
MEDIA_RETENTION_DAYS=2
MEDIA_CLEANUP_INTERVAL_SECONDS=3600
NOTIFICATION_QUEUE_MAXSIZE=10

# ------------------------------------------------------------
# CAMERA PROFILE CONTROL
# Firmware owns DAY/DUSK/NIGHT profiles by default. Enable this only if you
# intentionally want A12 to POST /settings profile changes from lux readings.
# ------------------------------------------------------------
A12_APPLY_CAMERA_PROFILES=false

# ------------------------------------------------------------
# AUDIO
# Pulls from ESP32 audio stream (:82) and embeds in clips.
# ------------------------------------------------------------
AUDIO_ENABLED=true
AUDIO_BUFFER_SECONDS=10
AUDIO_ANALYSIS_INTERVAL_SECONDS=0.25

# ------------------------------------------------------------
# MULTIPLE CAMERA INSTANCES
# Run the same A12 code with a different A12_DATA_DIR/config.env per camera.
# Do not copy or fork the Python scripts. Keep CAMERA_ID, MQTT_BASE_TOPIC,
# ESP32_IP, and ESP32_MQTT_DEVICE unique per instance.
# ------------------------------------------------------------
#ESP32_MQTT_DEVICE=ESP32-Camera

# ------------------------------------------------------------
# DEBUG
# ------------------------------------------------------------
DEBUG_DETECTION=false
#LOG_LEVEL=INFO
