# Single-camera A12 runtime config
CAMERA_ID=gate
CAMERA_NAME="Gate Camera"
CAMERA_LABEL="Gate"
ESP32_IP=192.0.2.100
ESP32_HTTP_USER=admin
ESP32_HTTP_PASS=admin
ESP32_MQTT_DEVICE=ESP32-Camera

MQTT_BROKER=192.0.2.10
MQTT_PORT=1883
MQTT_BASE_TOPIC=esp32_camera

YOLO_WEIGHTS=yolo11n.onnx
MOTION_THRESHOLD=0
STREAM_IDLE_DECODE_FPS=2
STREAM_ACTIVE_DECODE_FPS=10

TELEGRAM_MEDIA_MODE=preview_mp4
#TELEGRAM_ENABLED=true
#TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
#TELEGRAM_CHAT_ID=-100123456789

A12_APPLY_CAMERA_PROFILES=false
NOTIFICATION_QUEUE_MAXSIZE=10
AUDIO_ENABLED=true
DEBUG_DETECTION=false
LOG_LEVEL=INFO
